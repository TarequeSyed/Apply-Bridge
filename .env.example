# ApplyBridge Environment Configuration Template
# Copy this file to .env and populate with your credentials.
#
# QUICK START (Zero-Setup Offline Sandbox):
# If you run the app locally without a .env file, ApplyBridge automatically runs in
# offline sandbox mode with Dexie.js IndexedDB and 1-Click Demo login!
# No Firebase or Google Cloud setup is required to evaluate the core app.

# ==============================================================================
# 1. Firebase Authentication (Optional for cloud sync & Google Sign-In)
# ==============================================================================
# In Firebase Console (https://console.firebase.google.com):
# -> Create project -> Authentication -> Enable Google & Email/Password
# -> Settings -> Authorized Domains -> Ensure both are added:
#    - localhost
#    - apply-bridge-pi.vercel.app (or your custom deployment domain)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# ==============================================================================
# 2. Google OAuth 2.0 Client ID (For Live Gmail API Sync & Google Sign-In)
# ==============================================================================
# In Google Cloud Console (https://console.cloud.google.com/apis/credentials):
# -> Create Credentials -> OAuth client ID -> Application Type: "Web application"
# -> Authorized JavaScript origins (NO trailing slashes):
#      Local Dev:   http://localhost:5173
#      Production:  https://apply-bridge-pi.vercel.app
#      (Pro-Tip: Add BOTH origins so one Client ID works in local & production!)
# -> Authorized redirect URIs:
#      Local Dev:   http://localhost:5173 (and https://applybridge2.firebaseapp.com/__/auth/handler)
#      Production:  https://applybridge2.firebaseapp.com/__/auth/handler
#      (Pro-Tip: Add both redirect URIs so one Client ID covers both environments!)
# -> Enable the Gmail API: APIs & Services -> Library -> Search "Gmail API" -> Enable
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ==============================================================================
# 3. AI Provider API Keys (Multi-Model Auto-Resolver)
# ==============================================================================
# You only need to provide ANY ONE of these keys!
# ApplyBridge automatically auto-detects and runs whichever key you provide:
# - Gemini (Recommended, free tier available at https://aistudio.google.com)
# - Hugging Face (Free inference tokens at https://huggingface.co/settings/tokens)
# - Groq (Ultra-fast Llama-3 at https://console.groq.com)
# If left empty, ApplyBridge falls back to simulated zero-latency local engine.
VITE_GEMINI_API_KEY=
VITE_HUGGINGFACE_API_KEY=
VITE_GROQ_API_KEY=
