# ApplyBridge Environment Template
# Copy this file to .env and populate with your production Firebase credentials.

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Google Identity Services Client ID (PKCE client for recruiter mailbox queries)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# AI Provider API Keys (You only need to put ANY ONE of these models!)
# ApplyBridge automatically auto-detects and runs whichever key you provide.
VITE_GEMINI_API_KEY=
VITE_HUGGINGFACE_API_KEY=
VITE_GROQ_API_KEY=
